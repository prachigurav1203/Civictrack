# Copy values you need into application.properties or set them as environment variables (recommended on Windows: setx).
spring.datasource.url=jdbc:mysql://localhost:3306/civictrack?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=YOUR_MYSQL_PASSWORD
app.jwt.secret=REPLACE_WITH_A_RANDOM_STRING_OF_AT_LEAST_32_CHARACTERS
app.seed.demo-accounts=true
app.seed.admin-password=ChooseAStrongAdminPassword1
app.seed.officer-password=ChooseAStrongOfficerPassword1
app.seed.citizen-password=ChooseAStrongCitizenPassword1
app.geocoder.user-agent=CivicTrack/2.0 (your-email@example.com)
app.geocoder.country-codes=in
